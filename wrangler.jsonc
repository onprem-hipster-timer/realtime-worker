{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hipster-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "exports": {
    "UserHub": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "JWKS_URL": "https://api.example.com/auth/.well-known/jwks.json",
    "JWT_ISSUER": "https://api.example.com/auth/",
    "JWT_AUDIENCE": "https://api.example.com"
  }
  // routes, 실제 vars, PUSH_SECRET은 배포 환경에서 설정한다 (README).
}
