{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hipster-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }]
  },
  "exports": {
    "UserHub": { "type": "durable-object", "storage": "sqlite" }
  }
  // routes·vars·PUSH_SECRET은 배포 환경이 준다 (README "배포"). 로컬은 .dev.vars와 --var.
}
